      "Bash(cargo *)",
      "Bash(git *)",
      "Bash(npx *)",
      "Bash(pwsh *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)"
    ]
  },
  "hooks": {
