# Vanompp MySQL template
# Placeholders: {{ROOT}} = app root forward slashes, {{MYSQL_PORT}} = mysql port
[mysqld]
basedir="{{ROOT}}/bin/mysql"
datadir="{{ROOT}}/bin/mysql/data"
port={{MYSQL_PORT}}
bind-address=127.0.0.1
max_connections=50
# MySQL 8.0.40+: default_authentication_plugin deprecated, use authentication_policy
# Keep native for SMK compat (conn.php mysqli w/o caching_sha2), but use new syntax.
authentication_policy=mysql_native_password
# secure_file_priv points to tmp sibling (not data!) to keep data clean for --initialize
secure-file-priv="{{ROOT}}/bin/mysql/tmp"
tmpdir="{{ROOT}}/bin/mysql/tmp"
log-error="{{ROOT}}/bin/mysql/data/mysql_error.log"
pid-file="{{ROOT}}/bin/mysql/data/mysql.pid"
# SMK safe defaults low mem 64M for lab
innodb_buffer_pool_size=64M
key_buffer_size=16M
skip-name-resolve

[client]
port={{MYSQL_PORT}}
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
