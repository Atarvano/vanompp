# Vanompp MySQL template
# Placeholders: {{ROOT}} = app root forward slashes, {{MYSQL_PORT}} = mysql port
[mysqld]
basedir="{{ROOT}}/bin/mysql"
datadir="{{ROOT}}/bin/mysql/data"
port={{MYSQL_PORT}}
bind-address=127.0.0.1
max_connections=50
default_authentication_plugin=mysql_native_password
secure-file-priv="{{ROOT}}/bin/mysql/data"
tmpdir="{{ROOT}}/bin/mysql/data/tmp"
log-error="{{ROOT}}/bin/mysql/data/mysql_error.log"
pid-file="{{ROOT}}/bin/mysql/data/mysql.pid"
# SMK safe defaults
innodb_buffer_pool_size=64M
key_buffer_size=16M
skip-name-resolve

[client]
port={{MYSQL_PORT}}
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
