# Vanompp - build/outputs ignored, but KEEP source code tracked

# Rust build
/target/
**/*.rs.bk
Cargo.lock
src-tauri/target/
src-tauri/Cargo.lock

# Node
node_modules/
dist/
build/
.svelte-kit/
*.tsbuildinfo

# Tauri bundle + portable heavy bins
src-tauri/resources/bin/
!src-tauri/resources/bin/README.md
bin/
www/*
!www/.gitkeep

# Session-local working memory - NEVER push to GitHub (vibecoding traces)
# Kept on disk for Claude session persistence, but ignored in repo
docs/
.claude/
RECOVERY.md
.agents/
skills-lock.json
nul

# But keep GURU_SMK.txt (V1 tutorial) and CLAUDE.md — force-added via git add -f if ignored
!GURU_SMK.txt
!CLAUDE.md

# Heavy binaries / screenshots — never push
*.zip
*.png
src-tauri/gen/
screenshots/

# Env & secrets
.env
.env.local
*.log
*.pid
*.sock

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Graphify cache
graphify-out/

# Claude session local
.superpowers/
.serena/
